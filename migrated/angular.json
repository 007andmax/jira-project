{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "migrated": {
      "root": "src",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "../dist",
            "index": "src/index.html",
            "main": "src/ng2/main.ts",
            "polyfills": "src/ng2/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/ng2/assets",
              "src/ng1"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/ng2/styles.scss",
              "node_modules/datatables.net-dt/css/jquery.dataTables.css",
              "src/ng1/styles/admin-tickets.css",
              "src/ng1/styles/bootstrap-datetimepicker.css",
              "src/ng1/styles/common.dropdown.css",
              "src/ng1/styles/common.icons.css",
              "src/ng1/styles/common.left.css",
              "src/ng1/styles/common.lists.css",
              "src/ng1/styles/common.right.css",
              "src/ng1/styles/common.tables.css",
              "src/ng1/styles/common.ticket.add.css",
              "src/ng1/styles/common.ticket.alerts.css",
              "src/ng1/styles/common.ticket.attachments.css",
              "src/ng1/styles/common.ticket.email.css",
              "src/ng1/styles/common.ticket.header.css",
              "src/ng1/styles/common.ticket.list.css",
              "src/ng1/styles/common.ticket.updates.css",
              "src/ng1/styles/common.tickets.wells.css",
              "src/ng1/styles/common.top.css",
              "src/ng1/styles/companies.css",
              "src/ng1/styles/nanoscroller.css",
              "src/ng1/styles/nouislider.css",
              "src/ng1/styles/styles.css",
              "src/ng1/styles/tokenfield.css",
              "src/ng1/styles/users.css",
              "src/ng1/styles/vendors.css",
              "src/ng1/styles/crop.css",
              "src/ng1/styles/fixed.css",
              "src/ng1/styles/invoice-modal-tech.css",
              "src/ng1/styles/invoice-page.css",
              "src/ng1/styles/settings-company-info.css",
              "src/ng1/styles/quick-support.css",
              "src/ng1/styles/tax-rates.css",
              "src/ng1/styles/company-profile.css",
              "src/ng1/styles/time-zone-autocomplete.css",
              "src/ng1/styles/ticket-tags.css",
              "src/ng1/styles/loading-indicator.css",
              "src/ng1/styles/button-with-loading-indicator.css",
              "src/ng1/styles/settings.css",
              "src/ng1/styles/permissions-management.css",
              "src/ng1/styles/tracking-devices.css",
              "src/ng1/styles/left-panel.css",
              "src/ng1/styles/agent-install.css",
              "src/ng1/styles/datepicker.css",
              "src/ng1/styles/feed-back.css",
              "src/ng1/styles/welcome-wizard.css",
              "src/ng1/styles/modal-popup.css",
              "src/ng1/styles/dashboard.css",
              "src/ng1/styles/charts.css",
              "src/ng1/styles/hardware-report.css",
              "src/ng1/styles/card-view.css",
              "src/ng1/styles/password-manager.css",
              "src/ng1/styles/customer-report.css",
              "src/ng1/styles/new-style.css",
              "src/ng1/styles/nv.d3.css",
              "src/ng1/styles/daterangepicker.css",
              "node_modules/igniteui-angular/styles/igniteui-angular.css",
              "node_modules/timepicker/dist/jquery.timepicker.css",
              "./node_modules/ngx-toastr/toastr.css",
              "src/ng2/app/components/device/styles.scss"
            ],
            "scripts": [
              "src/ng2/assets/md5-min.js",
              "src/ng1/bower_components/jquery/dist/jquery.js",
              "src/ng1/bower_components/jquery-mousewheel/jquery.mousewheel.js",
              "src/ng1/bower_components/angular/angular.js",
              "src/ng1/bower_components/angular-messages/angular-messages.js",
              "src/ng1/bower_components/angular-ui-router/release/angular-ui-router.js",
              "src/ng1/bower_components/angular-ui-select/dist/select.js",
              "src/ng1/bower_components/angular-bootstrap/ui-bootstrap-tpls.js",
              "src/ng1/bower_components/angular-sanitize/angular-sanitize.js",
              "src/ng1/bower_components/angular-animate/angular-animate.js",
              "src/ng1/bower_components/tether/dist/js/tether.js",
              "src/ng1/bower_components/bootstrap/dist/js/bootstrap.js",
              "src/ng1/bower_components/bootstrap-tokenfield/dist/bootstrap-tokenfield.js",
              "src/ng1/bower_components/bootstrap3-typeahead/bootstrap3-typeahead.js",
              "src/ng1/bower_components/bootstrap-select/dist/js/bootstrap-select.js",
              "src/ng1/bower_components/moment/min/moment-with-locales.js",
              "src/ng1/bower_components/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js",
              "src/ng1/bower_components/typeahead.js/dist/typeahead.bundle.js",
              "src/ng1/bower_components/nanoscroller/bin/javascripts/jquery.nanoscroller.js",
              "src/ng1/bower_components/sockjs-client/dist/sockjs.js",
              "src/ng1/bower_components/stomp-websocket/lib/stomp.js",
              "src/ng1/bower_components/angular-local-storage/dist/angular-local-storage.js",
              "src/ng1/bower_components/d3/d3.js",
              "src/ng1/bower_components/ng-cropper/dist/ngCropper.all.js",
              "src/ng1/bower_components/nvd3/build/nv.d3.js",
              "src/ng1/bower_components/angular-nvd3/dist/angular-nvd3.js",
              "src/ng1/bower_components/angular-vs-repeat/src/angular-vs-repeat.js",
              "src/ng1/bower_components/bootstrap-daterangepicker/daterangepicker.js",
              "src/ng1/bower_components/angular-daterangepicker/js/angular-daterangepicker.js",
              "src/ng1/bower_components/ngInfiniteScroll/build/ng-infinite-scroll.js",
              "src/ng1/scripts/core/app.mdl.js",
              "src/ng1/scripts/admin/customer-list/customer-list.drv.js",
              "src/ng1/scripts/common/directives/feedback-form/feedback-form.drv.js",
              "src/ng1/scripts/common/directives/phone-numbers/phone-numbers.drv.js",
              "src/ng1/scripts/js/vendors/jquery.jscrollpane.js",
              "src/ng1/scripts/js/vendors/modernizr.js",
              "src/ng1/scripts/js/vendors/editor/jquery.hotkeys.js",
              "src/ng1/scripts/js/vendors/editor/editor.js",
              "src/ng1/scripts/js/vendors/pie-chart.js",
              "src/ng1/scripts/js/vendors/easeljs-0.6.1.min.js",
              "src/ng1/scripts/js/vendors/jquery.fileUploader.js",
              "src/ng1/scripts/js/vendors/jquery.autocomplete.js",
              "src/ng1/scripts/js/vendors/jquery.servicesMoving.js",
              "src/ng1/scripts/js/vendors/jquery.productAutocomplete.js",
              "src/ng1/scripts/js/vendors/md5-min.js",
              "src/ng1/scripts/js/vendors/nouislider.min.js",
              "src/ng1/scripts/js/vendors/date-range-picker/datepicker.js",
              "src/ng1/scripts/js/vendors/date-range-picker/datepicker.en.js",
              "src/ng1/scripts/js/handlebars-v3.0.3.js",
              "node_modules/datatables.net/js/jquery.dataTables.min.js"
            ],
            "es5BrowserSupport": true
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/ng2/environments/environment.ts",
                  "with": "src/ng2/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "6mb"
                }
              ]
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/ng2/environments/environment.ts",
                  "with": "src/ng2/environments/environment.dev.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "migrated:build",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "browserTarget": "migrated:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "migrated:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.scss",
              "node_modules/igniteui-angular/styles/igniteui-angular.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "migrated-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "prefix": "",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "migrated:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "migrated:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "migrated"
}