<!-- Middle Wrapper  -->
<div class="page-container">
  <div class="page-insider commision">
    <div class="heading">
      <h1>Commissions</h1>
      <div class="heading-serach">
        <a href="javascript:;" class="btn-outline">Add Commision</a>
      </div>
    </div>
      <tabset>
          <!-- Companies -->
          <tab heading="Companies’s Sales Person" id="tab1">
            <div class="cmn-area companies">
              <div class="data-table-wrap">

                <table class="display dataTable" style="width:100%">
                      <thead>
                        <tr>
                          <th class="c-name">Company </th>
                          <th class="address">Address</th>
                          <th class="sp">Sales Person</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                            <td class="c-name">
                              <div class="c-info">
                                 <span class="c-logo">DE</span>
                                 <h5>Dell</h5>
                              </div>
                            </td>
                            <td class="address">
                                824 16th Avenue Southwest <br>
                                Calgary, AB T2R 0S9
                            </td>
                            <td class="sp">
                              <div class="cmn-dropdown">
                                  <div class="drop-down-select" (click)="show = !show">
                                    <span class="selcted-dp">
                                       <img src="/ng2/assets/img/user.jpg" alt="user" />
                                    </span>
                                     <span class="selected-opt">Tony Dawson</span>
                                  </div>
                                  <div class="cmn-dropdon-list"  *ngIf="show">
                                     <form method="POST">
                                        <input type="text" placeholder="Search Tech Person"/>
                                     </form>
                                     <ul class="list-unstyled">
                                        <li>
                                          <span class="pic"><img src="/ng2/assets/img/user.jpg" alt="user" /></span>
                                           <div class="info">
                                             <h5>Tony Dawson</h5>
                                             <span class="email">bode.rigoberto@kemmer.com</span>
                                           </div>
                                        </li>
                                        <li>
                                            <span class="pic"><img src="/ng2/assets/img/user.jpg" alt="user" /></span>
                                             <div class="info">
                                               <h5>Tony Dawson</h5>
                                               <span class="email">bode.rigoberto@kemmer.com</span>
                                             </div>
                                          </li>
                                          <li>
                                              <span class="pic"><img src="/ng2/assets/img/user.jpg" alt="user" /></span>
                                               <div class="info">
                                                 <h5>Tony Dawson</h5>
                                                 <span class="email">bode.rigoberto@kemmer.com</span>
                                               </div>
                                            </li>
                                     </ul>
                                  </div>
                              </div>
                            </td>
                         </tr>
