          <!-- Contract  -->
          <tab heading="Contract">
              <div class="cmn-area contract">
                  <div class="data-table-wrap">
                    <table  class="display dataTable" style="width:100%">
                          <thead>
                            <tr>
                              <th class="p-name">Product Name</th>
                              <th class="rate">Rate (%)</th>
                              <th class="action">&nbsp;</th>
                            </tr>
