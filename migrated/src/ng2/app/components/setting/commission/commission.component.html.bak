                    </table>
                    <table  class="display dataTable" style="width:100%">
                        <tbody>
                          <tr>
                            <td class="p-name">
                              <h5 class="headings">Hourly Contracts</h5>
                              <p>Hourly Contracts will use the service default commission rate.</p>
                            </td>
                            <td class="rate">5%</td>
                            <td class="action">
                                <a href="javascript:;" data-tooltip="Edit" class="edit" ><img src="/ng2/assets/img//edit.svg" alt="Edit" /></a>
                                <a href="javascript:;" data-tooltip="Remove" class="remove"><img src="/ng2/assets/img//remove.svg" alt="Remove" /></a>
                            </td>
                          </tr>
                        </tbody>
                    </table>
                    <hr>
                    <table  class="display dataTable" style="width:100%">
                        <tbody>
                          <tr>
                            <td class="p-name">
                              <h5 class="headings">Block Time Contracts</h5>
                              <p>Block time contracts will be separated in two commissions rates, the first will be for the included Hours, a second rate can be set for Hours exceeding the included hours.</p>
                              <p></p>
                            </td>
                            <td class="rate">&nbsp;</td>
                            <td class="action">
                                &nbsp;
                            </td>
                          </tr>
                          <tr>
                              <td class="p-name">
                                <h5>Block time Included Hours commission Rate</h5>
                              </td>
                              <td class="rate">5%</td>
                              <td class="action">
                                  <a href="javascript:;" data-tooltip="Edit" class="edit" ><img src="/ng2/assets/img//edit.svg" alt="Edit" /></a>
                                  <a href="javascript:;" data-tooltip="Remove" class="remove"><img src="/ng2/assets/img//remove.svg" alt="Remove" /></a>
                              </td>
                          </tr>
                          <tr>
                              <td class="p-name">
                                <h5>Rate for hours Exceeding Included hours on Black Time Contracts</h5>
                              </td>
                              <td class="rate">5%</td>
                              <td class="action">
                                  <a href="javascript:;" data-tooltip="Edit" class="edit" ><img src="/ng2/assets/img//edit.svg" alt="Edit" /></a>
                                  <a href="javascript:;" data-tooltip="Remove" class="remove"><img src="/ng2/assets/img//remove.svg" alt="Remove" /></a>
                              </td>
                          </tr>
                        </tbody>
                    </table>
                    <hr>
                    <table  class="display dataTable" style="width:100%">
                        <tbody>
                          <tr>
                            <td class="p-name">
                              <h5 class="headings">Per User and Device Cotracts</h5>
                              <p>Managed Service. contracts will have two commissions rates, one for the Contract , and one for Exceeding maximum hours included in the contract, this will be the same for Per Device and Per User Contract. If you Bill the customer for Other services in the contracts then the additional services commission will be calculated by their rates in Services Commissions.</p>
                              <p></p>
                            </td>
                            <td class="rate">&nbsp;</td>
                            <td class="action">
                                &nbsp;
                            </td>
                          </tr>
                          <tr>
                              <td class="p-name">
                                <h5>Per User and Per Device Contracts</h5>
                              </td>
                              <td class="rate">5%</td>
                              <td class="action">
                                  <a href="javascript:;" data-tooltip="Edit" class="edit" ><img src="/ng2/assets/img//edit.svg" alt="Edit" /></a>
                                  <a href="javascript:;" data-tooltip="Remove" class="remove"><img src="/ng2/assets/img//remove.svg" alt="Remove" /></a>
                              </td>
                          </tr>
                          <tr>
                              <td class="p-name">
                                <h5>Rate for hours Exceeding Included hours on Block Time contracts</h5>
                              </td>
                              <td class="rate">5%</td>
                              <td class="action">
                                  <a href="javascript:;" data-tooltip="Edit" class="edit" ><img src="/ng2/assets/img//edit.svg" alt="Edit" /></a>
                                  <a href="javascript:;" data-tooltip="Remove" class="remove"><img src="/ng2/assets/img//remove.svg" alt="Remove" /></a>
                              </td>
                          </tr>
                        </tbody>
                    </table>
                    <hr>
                    <table  class="display dataTable" style="width:100%">
                        <tbody>
                          <tr>
                            <td class="p-name">
                              <h5 class="headings">Other Contracts</h5>
                              <p>commission rate will be calculated based on their Product and Service Commissions rates set in the Product and Service Commissions.</p>
