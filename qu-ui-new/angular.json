{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "qu-ui-new": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "styleext": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/qu-ui-new",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [
              "src/ng1/bower_components/jquery/dist/jquery.js",
              "src/ng1/bower_components/jquery-mousewheel/jquery.mousewheel.js",
              "src/ng1/bower_components/angular/angular.js",
              "src/ng1/bower_components/angular-messages/angular-messages.js",
              "src/ng1/bower_components/angular-ui-router/release/angular-ui-router.js",
              "src/ng1/bower_components/angular-ui-select/dist/select.js",
              "src/ng1/bower_components/angular-bootstrap/ui-bootstrap-tpls.js",
              "src/ng1/bower_components/angular-sanitize/angular-sanitize.js",
              "src/ng1/bower_components/angular-animate/angular-animate.js",
              "src/ng1/bower_components/tether/dist/js/tether.js",
              "src/ng1/bower_components/bootstrap/dist/js/bootstrap.js",
              "src/ng1/bower_components/bootstrap-tokenfield/dist/bootstrap-tokenfield.js",
              "src/ng1/bower_components/bootstrap3-typeahead/bootstrap3-typeahead.js",
              "src/ng1/bower_components/bootstrap-select/dist/js/bootstrap-select.js",
              "src/ng1/bower_components/moment/min/moment-with-locales.js",
              "src/ng1/bower_components/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js",
              "src/ng1/bower_components/typeahead.js/dist/typeahead.bundle.js",
              "src/ng1/bower_components/nanoscroller/bin/javascripts/jquery.nanoscroller.js",
              "src/ng1/bower_components/sockjs-client/dist/sockjs.js",
              "src/ng1/bower_components/stomp-websocket/lib/stomp.js",
              "src/ng1/bower_components/angular-local-storage/dist/angular-local-storage.js",
              "src/ng1/bower_components/d3/d3.js",
              "src/ng1/bower_components/ng-cropper/dist/ngCropper.all.js",
              "src/ng1/bower_components/nvd3/build/nv.d3.js",
              "src/ng1/bower_components/angular-nvd3/dist/angular-nvd3.js",
              "src/ng1/bower_components/angular-vs-repeat/src/angular-vs-repeat.js",
              "src/ng1/bower_components/bootstrap-daterangepicker/daterangepicker.js",
              "src/ng1/bower_components/angular-daterangepicker/js/angular-daterangepicker.js",
              "src/ng1/app/scripts/js/vendors/jquery.jscrollpane.js",
              "src/ng1/app/scripts/js/vendors/modernizr.js",
              "src/ng1/app/scripts/js/vendors/editor/jquery.hotkeys.js",
              "src/ng1/app/scripts/js/vendors/editor/editor.js",
              "src/ng1/app/scripts/js/vendors/pie-chart.js",
              "src/ng1/app/scripts/js/vendors/easeljs-0.6.1.min.js",
              "src/ng1/app/scripts/js/vendors/jquery.fileUploader.js",
              "src/ng1/app/scripts/js/vendors/jquery.autocomplete.js",
              "src/ng1/app/scripts/js/vendors/jquery.servicesMoving.js",
              "src/ng1/app/scripts/js/vendors/jquery.productAutocomplete.js",
              "src/ng1/app/scripts/js/vendors/md5-min.js",
              "src/ng1/app/scripts/js/vendors/nouislider.min.js",
              "src/ng1/app/scripts/js/vendors/date-range-picker/datepicker.js",
              "src/ng1/app/scripts/js/vendors/date-range-picker/datepicker.en.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "qu-ui-new:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "qu-ui-new:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "qu-ui-new:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "qu-ui-new-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "prefix": "",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "qu-ui-new:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "qu-ui-new:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "qu-ui-new"
}
